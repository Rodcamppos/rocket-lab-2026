# Copie este arquivo para ".env" e preencha a chave.
# Gere sua chave em https://openrouter.ai/keys (começa com sk-or-v1-)
OPENROUTER_API_KEY=sk-or-v1-SUA_CHAVE_AQUI

# --- Opcionais (os valores abaixo já são os padrões) ---
# Modelos gratuitos em ordem de tentativa (fallback), separados por vírgula:
# OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free
# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto):
# CINEROCKET_DB_PATH=data/cinerocket.db
# Máximo de linhas devolvidas ao modelo por consulta:
# MAX_ROWS=50
# Cache de respostas em disco (economiza as 50 requisições diárias):
# CACHE_ENABLED=true
